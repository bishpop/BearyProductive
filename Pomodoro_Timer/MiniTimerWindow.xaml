<Window x:Class="PomodoroTimer.MiniTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Timer" Height="60" Width="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded" MouseDown="Window_MouseDown">

    <Border x:Name="MiniBorder" CornerRadius="15" Background="#FFB7B2" BorderBrush="White" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="MiniTimeText" Text="25:00" 
                       Grid.Column="0"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="White" FontWeight="Bold" FontSize="20"
                       FontFamily="Segoe UI" Margin="10,0,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.3"/>
                </TextBlock.Effect>
            </TextBlock>

            <Button Grid.Column="1" Content="⤢" Click="Restore_Click"
                    Width="30" Height="30" Margin="5"
                    Background="Transparent" Foreground="White" 
                    FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="15" Background="#33FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>