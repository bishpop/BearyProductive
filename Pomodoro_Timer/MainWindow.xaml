<Window x:Class="PomodoroTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Timer" Height="500" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style TargetType="Button" x:Key="GlassButton">
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="15" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AAFFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowControlBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="15" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Name="PART_Track" CornerRadius="10" Background="#30FFFFFF" BorderThickness="0"/>
                            <Border Name="PART_Indicator" CornerRadius="10" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FloatingBear" 
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                     From="0" To="-8" Duration="0:0:2" 
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:15" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity" From="0.3" To="0.8" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Star3" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="360" To="0" Duration="0:0:20" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Star4" Storyboard.TargetProperty="Opacity" From="0.2" To="0.9" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainBorder" CornerRadius="30" Padding="20" Background="#FFB7B2" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="#555555"/>
        </Border.Effect>

        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="Star1" Text="★" FontSize="28" Foreground="#FFFFD1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,60,0,0" RenderTransformOrigin="0.5,0.5" Grid.RowSpan="4" Opacity="0.6">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="0"/>
                </TextBlock.RenderTransform></TextBlock>
            <TextBlock x:Name="Star2" Text="✨" FontSize="24" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,50" Grid.RowSpan="4" Opacity="0.5"/>
            <TextBlock x:Name="Star3" Text="★" FontSize="22" Foreground="#FFF9C4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,140" RenderTransformOrigin="0.5,0.5" Grid.RowSpan="4" Opacity="0.4">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="0"/>
                </TextBlock.RenderTransform></TextBlock>
            <TextBlock x:Name="Star4" Text="✦" FontSize="20" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,60,0" Grid.RowSpan="4" Opacity="0.7"/>
            <TextBlock Text="✨" FontSize="18" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,90" Grid.RowSpan="4" Opacity="0.4"/>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,5,0,0">
                    <Button Content="⚙" Click="Options_Click" Style="{StaticResource WindowControlBtn}" ToolTip="Settings"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                    <TextBlock x:Name="TopTitleText" Text="Beary Productive" Foreground="White" FontFamily="Comic Sans MS" FontSize="18" HorizontalAlignment="Center" Opacity="0.9">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="2" Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,5,0">

                    <Button Content="_" Click="Minimize_Click" Style="{StaticResource WindowControlBtn}" ToolTip="Mini Mode" Margin="0,0,5,0" VerticalContentAlignment="Bottom"/>

                    <Button Content="✕" Click="Close_Click" ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#44FF0000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock x:Name="StatusText" Text="Focus Time" Foreground="White" FontFamily="Comic Sans MS" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.9">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Image x:Name="FloatingBear" Source="/assets/bear.png" Width="130" Height="130" Margin="0,0,0,-10" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Image.RenderTransform>
                </Image>

                <Viewbox Height="80">
                    <TextBlock x:Name="TimerText" Text="25:00" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Rounded, Comic Sans MS, Arial">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="3" BlurRadius="5" Opacity="0.2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Viewbox>
            </StackPanel>

            <ProgressBar x:Name="TimerProgress" Grid.Row="2" Height="20" Value="50" Maximum="100" Margin="20,10,20,20" Foreground="White" Background="#40FFFFFF"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="▶ Start" Click="Start_Click" Style="{StaticResource GlassButton}" Width="80"/>
                <Button Content="⏸ Pause" Click="Pause_Click" Style="{StaticResource GlassButton}" Width="87"/>
                <Button Content="⟳ Reset" Click="Reset_Click" Style="{StaticResource GlassButton}" Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>